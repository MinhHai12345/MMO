# Copy this file to .env in the repository root.
# Spring Boot imports .env through application.yml; do not commit real credentials.

# Application

# MySQL - database must exist and be reachable before starting the app.
DB_URL=jdbc:mysql://localhost:3306/fb_ai?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=1234

# Content API
CONTENT_PUBLISHING_API_KEY=haivo
APP_INITIAL_DATA_AUTO_IMPORT=true

# Telegram
TELEGRAM_TOKEN=mock
TELEGRAM_BOT_USERNAME=H2_FB_Bot
TELEGRAM_CHANNEL_ID=mock
FREE_CHANNEL_ID=mock
PREMIUM_CHANNEL_ID=mock

# Twitter / X
TWITTER_CONSUMER_KEY=mock
TWITTER_CONSUMER_SECRET=mock
TWITTER_ACCESS_TOKEN=mock
TWITTER_ACCESS_SECRET=mock

# Facebook
FACEBOOK_PAGE_ID=mock
FACEBOOK_ACCESS_TOKEN=mock

# Stripe
STRIPE_API_KEY=mock
STRIPE_WEBHOOK_SECRET=mock

# Provider routing defaults are optional and have safe defaults in application.yml.
# Override only when needed, or pass a provider per execution to POST /cronjobs/{id}/start.
# Infrastructure settings (server port, profiles, Hikari, Hibernate, Quartz) stay in YAML.

# Provider configuration is bound through app.ingestion.provider-config.<PROVIDER>.
# SofaScore (no API key required by this configuration)
SOFA_SCORE_ENABLED=true
SOFA_SCORE_API_URL=https://api.sofascore.com/api/v1/
SOFA_SCORE_WEB_URL=https://www.sofascore.com
SOFASCORE_TOURNAMENT_REGION=EN
SOFASCORE_TOURNAMENT_IDS=
SOFASCORE_MAX_EVENT_PAGES=20
SOFASCORE_MAX_ROUNDS=50

# API-Football
API_FOOTBALL_ENABLED=true
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_API_KEY=mock
API_FOOTBALL_LEAGUE_IDS=
API_FOOTBALL_SEASONS=

# football-data.org
FOOTBALL_DATA_ENABLED=true
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
FOOTBALL_DATA_API_KEY=mock
FOOTBALL_DATA_COMPETITION_IDS=
FOOTBALL_DATA_SEASONS=

# Understat
UNDER_STATS_ENABLED=false
UNDERSTAT_BASE_URL=https://understat.com
UNDER_STATS_LEAGUE_IDS=
UNDER_STATS_SEASONS=

# Sync
APP_SYNC_BOOTSTRAP_ON_START=true
APP_SYNC_SEASONS_PER_LEAGUE=3
