# Copy this file to .env in the repository root.
# Spring Boot imports .env through application.yml; do not commit real credentials.

# Application
SERVER_PORT=8180
SPRING_PROFILES_ACTIVE=dev

# MySQL - database must exist and be reachable before starting the app.
DB_URL=jdbc:mock
DB_USERNAME=mock
DB_PASSWORD=mock

# Content API
CONTENT_PUBLISHING_API_KEY=mock
APP_INITIAL_DATA_AUTO_IMPORT=mock

# Telegram
TELEGRAM_TOKEN=mock
TELEGRAM_BOT_USERNAME=H2_FB_Bot
TELEGRAM_CHANNEL_ID=mock
FREE_CHANNEL_ID=mock
PREMIUM_CHANNEL_ID=mock

# Twitter / X
TWITTER_CONSUMER_KEY=mock
TWITTER_CONSUMER_SECRET=mock
TWITTER_ACCESS_TOKEN=mock
TWITTER_ACCESS_SECRET=mock

# Facebook
FACEBOOK_PAGE_ID=mock
FACEBOOK_ACCESS_TOKEN=mock

# Stripe
STRIPE_API_KEY=mock
STRIPE_WEBHOOK_SECRET=mock

# Ingestion provider routing
INGESTION_LEAGUE_PROVIDER=mock
INGESTION_TEAM_PROVIDER=mock
INGESTION_FIXTURE_PROVIDER=mock
INGESTION_STANDINGS_PROVIDER=mock
INGESTION_ODDS_PROVIDER=mock
INGESTION_HISTORICAL_STATS_PROVIDER=UNDER_STATS

# SofaScore (no API key required by this configuration)
SOFA_SCORE_URI=mock
SOFA_SCORE_WEB_URL=mock
SOFA_SCORE_TOURNAMENT_REGION=mock
SOFA_SCORE_MAX_EVENT_PAGES=mock
SOFA_SCORE_MAX_ROUNDS=mock

# API-Football
API_FOOTBALL_ENABLED=mock
API_FOOTBALL_URI=mock
API_FOOTBALL_API_KEY=mock

# football-data.org
FOOTBALL_DATA_ENABLED=mock
FOOTBALL_DATA_URI=mock
FOOTBALL_DATA_API_KEY=mock

# Understat
UNDER_STATS_ENABLED=mock
UNDER_STAT_BASE_URL=https://understat.com

# Sync
APP_SYNC_BOOTSTRAP_ON_START=mock
APP_SYNC_SEASONS_PER_LEAGUE=mock
