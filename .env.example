# Application
SPRING_PROFILES_ACTIVE=dev
SPRING_APPLICATION_NAME=mmo
SERVER_PORT=8188

# Database
DB_URL=jdbc:mysql://localhost:3306/fb_ai?serverTimezone=Asia/Ho_Chi_Minh&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=
DB_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver

# HikariCP
DB_POOL_MAX_SIZE=30
DB_POOL_MIN_IDLE=10
DB_CONNECTION_TIMEOUT=30000
DB_IDLE_TIMEOUT=600000

# JPA / Hibernate
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
JPA_OPEN_IN_VIEW=false
HIBERNATE_DIALECT=org.hibernate.dialect.MySQLDialect
HIBERNATE_FORMAT_SQL=true

# Quartz
QUARTZ_JOB_STORE_TYPE=jdbc
QUARTZ_INITIALIZE_SCHEMA=never
QUARTZ_DRIVER_DELEGATE_CLASS=org.quartz.impl.jdbcjobstore.StdJDBCDelegate

# Multipart uploads
MULTIPART_MAX_REQUEST_SIZE=10MB
MULTIPART_MAX_FILE_SIZE=10MB

# Application behavior
APP_INITIAL_DATA_AUTO_IMPORT=true

# Telegram
TELEGRAM_TOKEN=
TELEGRAM_BOT_USERNAME=H2_FB_Bot
TELEGRAM_CHANNEL_ID=
FREE_CHANNEL_ID=
PREMIUM_CHANNEL_ID=

# Twitter / X
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# Facebook
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=

# Stripe
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# SofaScore
SOFASCORE_API_URL=https://api.sofascore.com/api/v1/
SOFASCORE_WEB_URL=https://www.sofascore.com

# Data ingestion providers (must match the Provider enum)
INGESTION_LEAGUE_PROVIDER=API_FOOTBALL
INGESTION_TEAM_PROVIDER=API_FOOTBALL
INGESTION_FIXTURE_PROVIDER=API_FOOTBALL
INGESTION_STANDINGS_PROVIDER=API_FOOTBALL
INGESTION_ODDS_PROVIDER=API_FOOTBALL

# API-Football
API_FOOTBALL_ENABLED=true
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_API_KEY=
API_FOOTBALL_LEAGUE_IDS=
API_FOOTBALL_SEASONS=

# Understat
UNDERSTAT_BASE_URL=https://understat.com
